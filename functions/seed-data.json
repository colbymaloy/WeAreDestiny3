  "concepts": [
    {
      "slug": "ability-hud-evolution",
      "title": "Ability HUD Evolution",
      "creator": "QuietSignal",
      "type": "visual",
      "categories": [
        "ui",
        "abilities"
      ],
      "status": "direction",
      "date": "2026-04-12",
      "updated": "2026-05-14",
      "featured": true,
      "summary": "Cooldowns move out of the screen corners and into a radial band around the reticle, so ability state is read peripherally instead of by looking away from the fight.",
      "cover": {
        "type": "image",
        "media": "/media/concepts/c1.jpg",
        "thumbnail": "/media/concepts/c1.jpg"
      },
      "tools": [
        "Figma",
        "After Effects"
      ],
      "body": [
        {
          "type": "prose",
          "heading": "The idea",
          "text": "Destiny asks you to track four cooldowns while aiming at something trying to kill you. All four live in the bottom-left corner, which is the one place your eyes are not.\n\nMoving them into a faint radial band around the reticle puts ability state inside the cone of attention you already hold. You stop checking and start knowing."
        },
        {
          "type": "flow",
          "heading": "The proposal",
          "steps": [
            "Idle \u2014 Band sits at low opacity, barely present",
            "Charging \u2014 Arc segments fill as each ability recovers",
            "Ready \u2014 A single pulse, then the segment holds bright",
            "Spent \u2014 Segment drains from the point of use outward"
          ]
        },
        {
          "type": "list",
          "heading": "Why this matters",
          "items": [
            "Ability state is read without a saccade",
            "Cooldowns become spatial rather than numeric",
            "The corner HUD can shrink to almost nothing",
            "Works the same in first and third person"
          ]
        }
      ],
      "takeaways": [
        "Ability state belongs inside the cone of attention, not in a corner",
        "Duration reads better as an arc than as a number",
        "The HUD should get quieter as you get better, not louder"
      ],
