{
  "functions": [
    {
      "source": "functions",
      "codebase": "publish",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run bundle"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "_site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "index.html"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/api/submit",
        "function": {
          "functionId": "submitConcept",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/moderate",
        "function": {
          "functionId": "moderate",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/seed",
        "function": {
          "functionId": "seedBoard",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/claim",
        "function": {
          "functionId": "claimHandle",
          "region": "us-central1"
        }
      },
      {
        "source": "/concepts",
        "function": {
          "functionId": "ssr",
          "region": "us-central1"
        }
      },
      {
        "source": "/",
        "function": {
          "functionId": "ssr",
          "region": "us-central1"
        }
      },
      {
        "source": "/concepts/**",
        "function": {
          "functionId": "ssr",
          "region": "us-central1"
        }
      },
      {
        "source": "/questions/**",
        "function": {
          "functionId": "ssr",
          "region": "us-central1"
        }
      },
      {
        "source": "/concepts.json",
        "function": {
          "functionId": "ssr",
          "region": "us-central1"
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "ssr",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "comment": "Pages revalidate on every visit. Without this they were held for an hour, so a deploy could not reach anyone already carrying the old HTML — and the ?v= stamps on assets were useless, because the page naming the new stamp was itself stale. Assets below opt back into a long cache.",
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/media/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
