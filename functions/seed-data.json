{
  "questions": [
    {
      "slug": "core-loop",
      "question": "What's the core loop that would keep you logged in for years?",
      "categories": [
        "gameplay",
        "systems"
      ],
      "context": "Destiny's loop has been shoot, loot, upgrade, repeat since 2014. Seasons change what you shoot and what drops, but not the shape of the day.\n\nWhat would make the tenth year feel different from the first?"
    },
    {
      "slug": "consequences",
      "question": "How should consequences shape the world and its stories?",
      "categories": [
        "lore",
        "worlds"
      ],
      "context": "Almost nothing a player does leaves a mark. Destinations reset, factions survive their own defeats, and the world looks the same in year six as year one.\n\nWhat should persist?"
    },
    {
      "slug": "what-should-supers-become",
      "question": "What should Supers become?",
      "categories": [
        "abilities",
        "gameplay"
      ],
      "context": "A Super has been one oversized ability for a decade. Higher numbers and new elements changed what it looks like, not what it is."
    }
